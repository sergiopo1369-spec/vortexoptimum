---
import { CONTACT } from "../config/site";
import InteractiveRobot3D from "./InteractiveRobot3D.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
}
const { eyebrow = "Reims & Grand Est", title, subtitle } = Astro.props;

// Texture de fond générée par `npm run media:bg` (scripts/make-hero-bg.mjs) :
// dégradé vectoriel rendu en 2560/1280/640 px, net à toutes les tailles.
// Purement décorative (alt="") → jamais candidate au LCP (§6.2).
const BG_2560 = "/media/hero-bg-2560.webp";
const BG_1280 = "/media/hero-bg-1280.webp";
const BG_640 = "/media/hero-bg-640.webp";
---

<section class="relative isolate">
  <!-- Fond de base -->
  <div class="absolute inset-0 z-0" data-hero-bg aria-hidden="true">
    <div class="absolute inset-0" data-hero-bg-layer>
      <img
        src={BG_1280}
        srcset={`${BG_640} 640w, ${BG_1280} 1280w, ${BG_2560} 2560w`}
        sizes="100vw"
        width="2560"
        height="1440"
        alt=""
        class="h-full w-full object-cover"
        fetchpriority="low"
        decoding="async"
      />
    </div>
    <!-- Scrim optimisé -->
    <div
      class="absolute inset-0"
      style="background:
        linear-gradient(180deg, rgba(8,12,20,.30) 0%, rgba(8,12,20,.55) 45%, rgba(8,12,20,.92) 100%),
        radial-gradient(70rem 45rem at 25% 0%, rgba(34,211,238,.10), transparent 70%);"
    ></div>
    <!-- Canvas toile neuronale intégré proprement -->
    <canvas 
      id="neural-network-canvas" 
      class="absolute inset-0 w-full h-full pointer-events-none opacity-60 hidden lg:block"
      style="z-index: 1;"
    ></canvas>
  </div>

  <div
    class="container-page relative z-10 grid min-h-[86svh] items-center gap-10 py-16 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12"
  >
    <div class="flex min-w-0 flex-col">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl md:text-6xl">{title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-[var(--color-ink-muted)]">{subtitle}</p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/devis">Estimer mon projet en 1 min</a>
        <a class="btn btn-whatsapp" href={`https://wa.me/${CONTACT.whatsapp.waMe}`} rel="noopener" target="_blank">
          💬 Discuter sur WhatsApp
        </a>
      </div>

      <p class="mt-5 text-sm text-[var(--color-ink-muted)]">
        ⏱ Combien d'heures perdez-vous chaque mois à gérer vos rendez-vous ?{" "}
        <a href="/devis" class="font-semibold text-[var(--color-cyan-text)] link-underline">
          Calculez-le en 30 secondes →
        </a>
      </p>

      <dl class="mt-12 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-4 text-sm min-[420px]:grid-cols-3">
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Mise en ligne technique</dt>
          <dd class="text-[var(--color-ink)]">24h à 48h<span class="text-[var(--color-ink-faint)]">*</span></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Performance mobile visée</dt>
          <dd class="text-[var(--color-ink)]">Lighthouse ≥ 90</dd>
        </div>
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Réponse WhatsApp</dt>
          <dd class="text-[var(--color-ink)]">&lt; 2h ouvrées</dd>
        </div>
      </dl>
      <p class="mt-4 max-w-2xl text-xs text-[var(--color-ink-faint)]">
        * Délai de mise en ligne technique à compter de la réception complète et validée
        de vos contenus (textes, logo, domaine, photos). En l'absence d'un élément, le
        délai démarre à réception du dernier élément manquant.
      </p>
    </div>

    <div class="mx-auto w-full max-w-[16rem] sm:max-w-xs lg:max-w-none">
      <InteractiveRobot3D />
    </div>
  </div>
</section>

<style>
  /* Hero styles fixes - sin overflow */
  [data-hero-bg-layer] {
    transform: none;
    will-change: auto;
  }
  
  /* Styles bouton WhatsApp */
  .btn-whatsapp {
    background: linear-gradient(135deg, #25D366 0%, #1da851 100%);
    border: 2px solid #25D366;
    color: white !important;
    box-shadow: 0 0 15px rgba(37, 211, 102, 0.3);
    transition: all 0.3s ease;
  }
  
  .btn-whatsapp:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(37, 211, 102, 0.4);
    border-color: #1da851;
  }
</style>

<script>
  // Inicialización de la toile neuronale solo en desktop
  import { initNeuralNetwork } from '../scripts/neural-network.ts';
  
  if (window.innerWidth >= 1024 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.addEventListener('DOMContentLoaded', () => {
      initNeuralNetwork();
    });
  }
</script>
