---
import { euros } from "../lib/quote";
import type { Pack } from "../config/pricing";

export interface Props {
  pack: Pack;
  /** Force la mise en avant même sans `variant` défini sur le pack. */
  featured?: boolean;
  /** Pré-sélectionne ce pack dans le calculateur. */
  quoteHref?: string;
}
const { pack, featured = false, quoteHref = `/devis?pack=${pack.id}` } = Astro.props;

const variant = pack.variant ?? (featured ? "featured" : undefined);
const isFeatured = variant === "featured" || variant === "ultimate";
const isUltimate = variant === "ultimate";
const badge = pack.badge ?? (variant === "featured" ? "Le plus demandé" : null);
---

<article
  class:list={[
    "flex flex-col p-6",
    isUltimate ? "glass glass-glow pack-ultimate" : isFeatured ? "glass glass-glow glass-strong" : "glass",
  ]}
>
  {badge && (
    <p
      class:list={[
        "mb-3 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold",
        isUltimate
          ? "border-0 text-[#04121a] bg-gradient-to-r from-[#00e5ff] to-[#a855f7]"
          : "border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-emerald-text)]",
      ]}
    >
      {badge}
    </p>
  )}
  <h3 class="text-xl font-semibold">{pack.label}</h3>
  <p class="mt-3 text-sm text-[var(--color-ink-muted)]">{pack.description}</p>

  <p class="mt-6">
    <span class="text-3xl font-semibold">{euros(pack.setup)}</span>
    <span class="text-[var(--color-ink-faint)]"> installation</span>
    <span class="mx-1 text-[var(--color-ink-faint)]">+</span>
    <span class="text-3xl font-semibold">{euros(pack.monthly)}</span>
    <span class="text-[var(--color-ink-faint)]">/mois</span>
  </p>

  {pack.compareSetup && pack.compareMonthly && (
    <p class="mt-1 text-xs text-[var(--color-ink-faint)]">
      au lieu de <s>{euros(pack.compareSetup)} + {euros(pack.compareMonthly)}/mois</s> à la carte
    </p>
  )}

  {/*
    Sur mobile les trois packs s'empilent : leurs listes complètes allongeaient la
    page de plusieurs écrans avant le moindre bouton. Servi `open` — donc complet
    sur desktop et sans JS — et refermé uniquement sous 640 px par le <script>.
  */}
  <details class="pack-details" open>
    <summary class="pack-summary">
      Voir le détail — {pack.includes.length + pack.freebies.length} prestations
    </summary>

    <ul class="mt-4 space-y-2 text-sm sm:mt-6">
      {pack.includes.map((f) => (
        <li class="flex gap-2">
          <span aria-hidden="true" class="mt-0.5 text-[var(--color-cyan-text)]">✓</span>
          <span>{f}</span>
        </li>
      ))}
    </ul>

    {pack.freebies.length > 0 && (
      <ul class="mt-4 space-y-2 border-t border-[var(--color-border)] pt-4 text-sm text-[var(--color-ink-muted)]">
        {pack.freebies.map((f) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="mt-0.5">🎁</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    )}
  </details>

  <a class:list={["btn mt-6", isFeatured ? "btn-primary" : "btn-ghost"]} href={quoteHref}>
    {isUltimate ? "Choisir cette offre" : "Configurer ce pack"}
  </a>
</article>

<style>
  .pack-summary {
    cursor: pointer;
    margin-top: 1.5rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    list-style: none;
  }
  .pack-summary::-webkit-details-marker {
    display: none;
  }
  .pack-summary::after {
    content: " ▾";
    color: var(--color-cyan-text);
  }
  .pack-details[open] > .pack-summary::after {
    content: " ▴";
  }
  .pack-summary:hover {
    color: var(--color-ink);
    border-color: color-mix(in oklab, var(--color-cyan) 45%, transparent);
  }
  .pack-summary:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }

  /*
    `display: contents` ne suffisait PAS à réafficher le contenu : Chrome masque
    le contenu d'un <details> fermé via content-visibility sur ::details-content,
    que la boîte du details existe ou non — les listes disparaissaient du desktop.
    Le <details> est donc rendu `open` par défaut : desktop et navigation sans JS
    voient tout, et seul le mobile referme (voir le <script>).
  */
  @media (min-width: 640px) {
    .pack-summary {
      display: none;
    }
  }

  .pack-ultimate {
    box-shadow:
      0 0 40px -12px rgba(0, 229, 255, 0.35),
      0 0 62px -22px rgba(168, 85, 247, 0.4);
  }
</style>

<script>
  /*
    Le <details> est servi ouvert : sans JS, ou sur desktop, la fiche reste
    complète. Seul le mobile le referme, pour éviter que les trois packs
    empilés n'allongent la page de plusieurs écrans avant le premier bouton.
    Un pack déjà déplié par l'utilisateur n'est jamais refermé de force.
  */
  const etroit = window.matchMedia("(max-width: 639px)");
  const packs = document.querySelectorAll<HTMLDetailsElement>(".pack-details");

  function appliquer(e: MediaQueryList | MediaQueryListEvent) {
    packs.forEach((d) => {
      if (e.matches) {
        if (d.dataset.userOpen !== "1") d.open = false;
      } else {
        d.open = true;
      }
    });
  }

  packs.forEach((d) => {
    d.addEventListener("toggle", () => {
      if (etroit.matches && d.open) d.dataset.userOpen = "1";
    });
  });

  appliquer(etroit);
  etroit.addEventListener("change", appliquer);
</script>
