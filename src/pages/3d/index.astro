---
/*
  Écran PUBLIC de la boutique « 3D » — volontairement sobre et dépourvu de
  tout champ de saisie, bouton de connexion ou lien vers la route privée.

  Architecture à deux routes séparées :
    - /3d (ici)          → écran public "Accès Verrouillé", aucune information
                            sur le mécanisme réel de gate.
    - /espace-3d-reserve → route privée dédiée (non liée depuis cette page ni
                            depuis la nav), qui héberge le vrai formulaire de
                            déverrouillage. Voir README-3D.md.

  Non indexée (noindex + robots.txt + filtre sitemap), cf. Layout3D.astro.
*/
import Layout3D from "../../layouts/Layout3D.astro";
---

<Layout3D title="Accès verrouillé — 3D">
  <section class="mx-auto flex min-h-[100dvh] max-w-sm flex-col items-center justify-center px-6 text-center">
    <div
      class="flex h-16 w-16 items-center justify-center rounded-full border border-cyan-500/30 bg-cyan-500/10 text-3xl"
      aria-hidden="true"
    >
      🔒
    </div>
    <h1 class="mt-6 text-2xl font-extrabold text-white">Accès Verrouillé</h1>
    <p class="mt-3 text-sm leading-relaxed text-slate-400">
      Espace actuellement restreint et réservé aux clients autorisés.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center rounded-lg border border-slate-700 px-5 py-2.5 text-sm text-slate-300 transition-colors hover:border-cyan-400/50 hover:text-white"
    >
      Retour à l'accueil
    </a>
  </section>
</Layout3D>
