---
/*
  Layout autonome de la boutique « 3D ».

  Volontairement SANS Header / Footer / nav / bandeau cookies du site
  principal : cette section est isolée, non liée depuis le reste du site,
  exclue du référencement (noindex + robots.txt + filtre sitemap).

  Charte Dark Futuriste conservée (fond #080c14, accents cyan) mais
  identité visuelle distincte : pas de logo cliquable renvoyant à l'accueil.
*/
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: #080c14;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background:
          radial-gradient(60rem 40rem at 15% -10%, rgba(34, 211, 238, 0.12), transparent 60%),
          radial-gradient(48rem 40rem at 100% 0%, rgba(168, 85, 247, 0.1), transparent 55%),
          #080c14;
        color: #f4f7fb;
        font-family:
          "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
      }
      :focus-visible {
        outline: 2px solid #22d3ee;
        outline-offset: 2px;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
