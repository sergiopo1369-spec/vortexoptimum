---
import { CONTACT } from "../config/site";

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
}
const { eyebrow = "Reims & Grand Est", title, subtitle } = Astro.props;

const BG_2560 = "/media/hero-bg-2560.webp";
const BG_1280 = "/media/hero-bg-1280.webp";
const BG_640 = "/media/hero-bg-640.webp";
---

<section class="relative isolate">
  <!-- Fond de base -->
  <div class="absolute inset-0 z-0" data-hero-bg aria-hidden="true">
    <div class="absolute inset-0" data-hero-bg-layer>
      <img
        src={BG_1280}
        srcset={`${BG_640} 640w, ${BG_1280} 1280w, ${BG_2560} 2560w`}
        sizes="100vw"
        width="2560"
        height="1440"
        alt=""
        class="h-full w-full object-cover"
        fetchpriority="low"
        decoding="async"
      />
    </div>
    <!-- Scrim optimisé -->
    <div
      class="absolute inset-0"
      style="background:
        linear-gradient(180deg, rgba(8,12,20,.30) 0%, rgba(8,12,20,.55) 45%, rgba(8,12,20,.92) 100%),
        radial-gradient(70rem 45rem at 25% 0%, rgba(34,211,238,.10), transparent 70%);"
    ></div>
  </div>

  <div
    class="container-page relative z-10 grid min-h-[min(76svh,50rem)] items-center gap-8 py-12 sm:min-h-[min(86svh,50rem)] sm:gap-10 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12"
  >
    <div class="relative z-10 flex min-w-0 flex-col">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl md:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base text-[var(--color-ink-muted)] sm:mt-6 sm:text-lg">{subtitle}</p>

      <div class="mt-7 grid grid-cols-1 gap-3 sm:mt-9 sm:flex sm:flex-wrap">
        <a class="btn btn-primary" href="/devis">Estimer mon projet en 1 min</a>
        <a class="btn btn-whatsapp" href={`https://wa.me/${CONTACT.whatsapp.waMe}`} rel="noopener" target="_blank">
          💬 Discuter sur WhatsApp
        </a>
      </div>

      <p class="mt-4 text-sm text-[var(--color-ink-muted)] sm:mt-5">
        ⏱ Combien d'heures perdez-vous chaque mois à gérer vos rendez-vous ?{" "}
        <a href="/devis" class="font-semibold text-[var(--color-cyan-text)] link-underline">
          Calculez-le en 30 secondes →
        </a>
      </p>

      <dl class="mt-8 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-3 text-sm min-[420px]:grid-cols-3 sm:mt-12 sm:gap-y-4">
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Mise en ligne technique</dt>
          <dd class="text-[var(--color-ink)]">24h à 48h<span class="text-[var(--color-ink-faint)]">*</span></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Performance mobile visée</dt>
          <dd class="text-[var(--color-ink)]">Lighthouse ≥ 90</dd>
        </div>
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Contact WhatsApp</dt>
          <dd class="text-[var(--color-ink)]">Jours ouvrés, 9h–19h</dd>
        </div>
      </dl>
      <p class="mt-4 max-w-2xl text-xs text-[var(--color-ink-faint)]">
        * Délai de mise en ligne technique à compter de la réception complète et validée
        de vos contenus (textes, logo, domaine, photos). En l'absence d'un élément, le
        délai démarre à réception du dernier élément manquant.
      </p>
    </div>

    <!-- Panneau décoratif : indicateurs clés -->
    <div class="hero-panel" aria-hidden="true">
      <div class="hero-panel__inner">
        <!-- Carte principale -->
        <div class="hero-card hero-card--main">
          <div class="hero-card__icon">🚀</div>
          <div>
            <p class="hero-card__label">Sites livrés à Reims</p>
            <p class="hero-card__value">24h – 48h</p>
          </div>
        </div>

        <!-- Grille de métriques -->
        <div class="hero-metrics">
          <div class="hero-metric">
            <span class="hero-metric__num">≥ 90</span>
            <span class="hero-metric__label">Lighthouse</span>
          </div>
          <div class="hero-metric">
            <span class="hero-metric__num">≥ 99,9%</span>
            <span class="hero-metric__label">Disponibilité</span>
          </div>
          <div class="hero-metric hero-metric--accent">
            <span class="hero-metric__num">600€</span>
            <span class="hero-metric__label">Dès / HT</span>
          </div>
          <div class="hero-metric">
            <span class="hero-metric__num">0</span>
            <span class="hero-metric__label">Engagement</span>
          </div>
        </div>

        <!-- Carte sécurité -->
        <div class="hero-card hero-card--security">
          <div class="hero-card__icon">🔒</div>
          <div>
            <p class="hero-card__label">Sécurité & Antivirus</p>
            <p class="hero-card__value">Inclus dans chaque pack</p>
          </div>
        </div>

        <!-- Décoration géométrique -->
        <div class="hero-geo" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="80" stroke="rgba(0,229,255,0.08)" stroke-width="1"/>
            <circle cx="100" cy="100" r="55" stroke="rgba(0,229,255,0.12)" stroke-width="1"/>
            <circle cx="100" cy="100" r="30" stroke="rgba(168,85,247,0.15)" stroke-width="1"/>
            <line x1="20" y1="100" x2="180" y2="100" stroke="rgba(0,229,255,0.06)" stroke-width="1"/>
            <line x1="100" y1="20" x2="100" y2="180" stroke="rgba(0,229,255,0.06)" stroke-width="1"/>
            <line x1="43" y1="43" x2="157" y2="157" stroke="rgba(168,85,247,0.06)" stroke-width="1"/>
            <line x1="157" y1="43" x2="43" y2="157" stroke="rgba(168,85,247,0.06)" stroke-width="1"/>
            <circle cx="100" cy="20" r="3" fill="rgba(0,229,255,0.4)"/>
            <circle cx="180" cy="100" r="3" fill="rgba(0,229,255,0.4)"/>
            <circle cx="100" cy="180" r="3" fill="rgba(168,85,247,0.4)"/>
            <circle cx="20" cy="100" r="3" fill="rgba(168,85,247,0.4)"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero-bg-layer] {
    transform: none;
    will-change: auto;
  }

  /* Panneau décoratif — masqué sur mobile, visible dès lg */
  .hero-panel {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-panel {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .hero-panel__inner {
    position: relative;
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  /* Carte informative */
  .hero-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(0, 229, 255, 0.15);
    background: rgba(8, 12, 20, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 0 24px rgba(0, 229, 255, 0.06), inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .hero-card--main {
    border-color: rgba(0, 229, 255, 0.22);
    box-shadow: 0 0 32px rgba(0, 229, 255, 0.10), inset 0 1px 0 rgba(255,255,255,0.05);
  }

  .hero-card--security {
    border-color: rgba(168, 85, 247, 0.2);
    box-shadow: 0 0 24px rgba(168, 85, 247, 0.08), inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .hero-card__icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .hero-card__label {
    font-size: 0.7rem;
    color: rgba(148, 163, 184, 0.8);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
  }

  .hero-card__value {
    font-size: 0.95rem;
    font-weight: 600;
    color: #e2e8f0;
    margin: 0.1rem 0 0;
  }

  /* Grille de métriques */
  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .hero-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.875rem 0.75rem;
    border-radius: 0.875rem;
    border: 1px solid rgba(51, 65, 85, 0.6);
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-align: center;
    gap: 0.25rem;
  }

  .hero-metric--accent {
    border-color: rgba(0, 229, 255, 0.25);
    background: rgba(0, 229, 255, 0.05);
  }

  .hero-metric__num {
    font-size: 1.25rem;
    font-weight: 700;
    color: #00e5ff;
    line-height: 1.1;
  }

  .hero-metric--accent .hero-metric__num {
    background: linear-gradient(135deg, #00e5ff, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-metric__label {
    font-size: 0.68rem;
    color: rgba(148, 163, 184, 0.7);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Décoration géométrique centrée derrière les cartes */
  .hero-geo {
    position: absolute;
    inset: -3rem;
    z-index: -1;
    opacity: 0.6;
    pointer-events: none;
  }

  .hero-geo svg {
    width: 100%;
    height: 100%;
  }

  /* Bouton WhatsApp */
  .btn-whatsapp {
    background: linear-gradient(135deg, #25D366 0%, #1da851 100%);
    border: 2px solid #25D366;
    color: white !important;
    box-shadow: 0 0 15px rgba(37, 211, 102, 0.3);
    transition: all 0.3s ease;
  }

  .btn-whatsapp:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(37, 211, 102, 0.4);
    border-color: #1da851;
  }
</style>
