---
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  description?: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} noindex={false}>
  <article class="container-page py-16">
    <div class="prose-vx mx-auto max-w-2xl">
      <p class="eyebrow">Informations légales</p>
      <h1 class="mt-3 text-3xl font-semibold">{title}</h1>
      <p class="text-sm text-[var(--color-ink-faint)]">Dernière mise à jour : {updated}</p>
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose-vx h2 { font-size: 1.3rem; font-weight: 600; margin: 2rem 0 0.6rem; color: var(--color-ink); }
  .prose-vx h3 { font-size: 1.05rem; font-weight: 600; margin: 1.4rem 0 0.4rem; color: var(--color-ink); }
  .prose-vx p, .prose-vx li { color: var(--color-ink-muted); line-height: 1.7; }
  .prose-vx p { margin: 0.8rem 0; }
  .prose-vx ul { margin: 0.8rem 0; padding-left: 1.2rem; }
  .prose-vx li { margin: 0.35rem 0; }
  .prose-vx li::marker { color: var(--color-cyan); }
  .prose-vx strong { color: var(--color-ink); }
  .prose-vx a { text-decoration: underline; text-underline-offset: 3px; }
  .prose-vx table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .prose-vx th, .prose-vx td { border: 1px solid var(--color-border); padding: 0.5rem 0.6rem; text-align: left; vertical-align: top; }
  .prose-vx .todo { color: var(--color-amethyst-text); font-weight: 600; }
</style>
