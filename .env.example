# Copiez ce fichier en `.env` (déjà gitignoré) et renseignez les valeurs.

# --- Boutique privée /3d -----------------------------------------------------
# Hash SHA-256 (hex minuscule) du mot de passe d'accès à /3d.
# NE mettez JAMAIS le mot de passe en clair. Générez le hash :
#
#   node -e "console.log(require('crypto').createHash('sha256').update('MON_MOT_DE_PASSE').digest('hex'))"
#   # ou :  printf '%s' 'MON_MOT_DE_PASSE' | openssl dgst -sha256
#
# Préfixe PUBLIC_ = exposé au navigateur (gate client-side assumé — voir README-3D.md).
# Exemple ci-dessous = hash du mot de passe "demo" (à remplacer).
PUBLIC_SHOP_3D_HASH=2a97516c354b68848cdbd8f54a226a0a55b21ed138e207ad6c5cbb9c00aa5aea

# --- Assistant WhatsApp (fonction serverless /api/whatsapp) -------------------
# Aucune de ces variables n'est nécessaire pour faire tourner le site en local :
# elles se règlent dans Vercel → Settings → Environment Variables.
# Marche à suivre complète : docs/agent-whatsapp/INSTALLATION.md

# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=           # chaîne inventée par nous, recopiée dans la config du webhook Meta
META_APP_SECRET=             # Meta → App → Paramètres → Général → Clé secrète
WHATSAPP_TOKEN=              # jeton permanent du compte système (ne pas utiliser le jeton temporaire 24h)
WHATSAPP_PHONE_NUMBER_ID=    # identifiant du numéro expéditeur (PAS le numéro lui-même)
WHATSAPP_GRAPH_VERSION=v21.0 # facultatif
TEAM_WHATSAPP_NUMBER=        # numéro alerté à chaque lead, E.164 SANS le +, ex. 33758187675

# Anthropic
ANTHROPIC_API_KEY=           # console.anthropic.com → API keys
ANTHROPIC_MODEL=claude-sonnet-5   # facultatif
ANTHROPIC_EFFORT=medium           # facultatif : low | medium | high | xhigh | max

# Notion (facultatif — sans ça, l'agent répond et alerte l'équipe, mais n'archive rien)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Mémoire des conversations (Vercel → Storage → Redis : les deux variables sont
# injectées automatiquement). Sans elles, l'agent oublie tout entre deux messages.
KV_REST_API_URL=
KV_REST_API_TOKEN=
