---
/*
  Audit Éclair — questionnaire 4 étapes + calcul déterministe (Vanilla JS, zéro dépendance).

  Étape 1 : quatre questions de qualification (friction, volume hebdo, relance devis,
            temps administratif déclaré).
  Étape 2 : algorithme déterministe (constantes et formules dans le <script> client ;
            le frontmatter ne fournit que les données des questions + paramètres).
  Étape 3 : restitution (alerte opérationnelle #080c14 / ambre + projection Vortex Optim
            cyan #00e5ff + CTA redirigeant vers /devis avec pré-remplissage du pack pro).

  Accessibilité : navigation clavier native (fieldset/legend + radios), libellés
  explicites, focus conservé à chaque transition, prefers-reduced-motion respecté.
*/

/** Option de question (champs optionnels selon la question Q1→Q4). */
type QuizOption = {
  label: string;
  emoji?: string;
  /** Q2 — volume hebdomadaire + panier moyen. */
  volume?: number;
  panier?: number;
  /** Q3 — taux de perte de devis. */
  taux?: number;
  /** Q4 — heures administratives déclarées / semaine. */
  heures?: number;
};

type Question = { id: string; label: string; options: QuizOption[] };

const QUESTIONS: Question[] = [
  {
    id: "friction",
    label: "Quelle est la principale friction dans vos opérations quotidiennes ?",
    options: [
      { label: "Interruption constante par les appels entrants et demandes de renseignements", emoji: "📞" },
      { label: "Taux d'absentéisme client aux rendez-vous programmés (no-shows sans préavis)", emoji: "❌" },
      { label: "Délai excessif dans l'édition et le suivi commercial des devis", emoji: "📝" },
      { label: "Messages WhatsApp et emails qui s'accumulent sans réponse rapide", emoji: "💬" },
    ],
  },
  {
    id: "volume",
    label: "Quel est le volume hebdomadaire moyen de dossiers, clients ou chantiers traités ?",
    options: [
      { label: "Moins de 10 clients / semaine", volume: 8, panier: 450 },
      { label: "10 à 25 clients / semaine", volume: 18, panier: 280 },
      { label: "25 à 50 clients / semaine", volume: 38, panier: 160 },
      { label: "Plus de 50 clients / semaine", volume: 65, panier: 110 },
    ],
  },
  {
    id: "relance",
    label: "Quel est votre protocole actuel de relance des devis en attente ?",
    options: [
      { label: "Relance systématique et manuelle sous 48h", taux: 0.1 },
      { label: "Relance ponctuelle selon la charge de travail restante", taux: 0.25 },
      { label: "Absence de relance formalisée par manque de temps", taux: 0.45 },
      { label: "Suivi partiel sur carnet ou tableur sans automatisation", taux: 0.3 },
    ],
  },
  {
    id: "heures",
    label:
      "Selon vous, combien d'heures par semaine ces tâches administratives et répétitives vous font-elles perdre ?",
    options: [
      { label: "Moins de 3 heures / semaine", heures: 2.5 },
      { label: "3 à 6 heures / semaine", heures: 4.5 },
      { label: "6 à 10 heures / semaine", heures: 8 },
      { label: "Plus de 10 heures / semaine (soirées et week-ends entamés)", heures: 12 },
    ],
  },
];

/** Paramètres fixes du modèle (Étape 2). */
const PARAMS = {
  semainesAn: 46,
  valeurHoraire: 55,
  noShow: 0.12,
  forfaitAn: 1398,
  roiMin: 4,
  roiMax: 9,
} as const;
---

<section id="calculateur-roi" class="relative scroll-mt-24 border-t border-slate-800/80 bg-slate-950/60 py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- En-tête -->
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <span
        class="mb-3 inline-flex items-center gap-1.5 rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-400"
      >
        ⚡ Audit Éclair — sans engagement
      </span>
      <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
        Audit Éclair : Évaluez le manque à gagner opérationnel de votre entreprise
      </h2>
      <p class="mt-2 text-sm text-slate-400">
        4 paramètres clés pour quantifier avec précision vos fuites de chiffre d'affaires et d'heures dirigeant.
      </p>
    </div>

    <!-- Wizard : 4 étapes de qualification -->
    <div id="roi-wizard" class="mx-auto max-w-3xl" aria-live="polite" aria-relevant="all">
      <div class="mb-5 flex items-center justify-between gap-3">
        <p id="roi-progress-label" class="text-xs font-semibold uppercase tracking-wide text-cyan-400">
          Question 1 / 4
        </p>
        <ol class="flex items-center gap-1.5" aria-label="Progression du questionnaire">
          {QUESTIONS.map((_, i) => (
            <li>
              <span
                id={`roi-dot-${i}`}
                class="roi-dot"
                data-active={i === 0 ? "true" : "false"}
                data-done="false"
                aria-hidden="true"
              ></span>
            </li>
          ))}
        </ol>
      </div>

      <div class="grid gap-2">
        {QUESTIONS.map((q, qi) => (
          <fieldset
            id={`roi-step-${qi + 1}`}
            class="roi-step rounded-2xl border border-slate-800 bg-slate-900/50 p-5 sm:p-6"
            hidden={qi > 0}
            data-step={qi + 1}
          >
            <legend class="text-base font-semibold text-white">{qi + 1}. {q.label}</legend>
            <div class="mt-4 grid gap-3">
              {q.options.map((o, oi) => (
                <label
                  class="roi-opt flex cursor-pointer items-start gap-2.5 rounded-xl border border-slate-700 bg-slate-900/40 p-3.5 transition-colors hover:border-cyan-400/40"
                >
                  <input type="radio" name={`roi-q${qi + 1}`} value={String(oi)} class="sr-only" />
                  <span class="min-h-6 text-sm leading-relaxed text-slate-200">
                    {o.emoji ? `${o.emoji} ` : ""}{o.label}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
    </div>
<!-- Analyse en cours (1,2 s) -->
    <div id="roi-analyse" class="mx-auto max-w-3xl relative" hidden>
      <div
        class="rounded-2xl border border-cyan-500/30 bg-[#080c14] px-6 py-8 text-center shadow-[0_0_30px_rgba(0,229,255,0.10)]"
      >
        <span class="roi-spinner" aria-hidden="true"></span>
        <p class="mt-4 text-sm font-medium text-cyan-300">Calcul de vos métriques opérationnelles…</p>
        <p class="mt-1 text-xs text-slate-500">Analyse de vos réponses en cours.</p>
      </div>
    </div>

    <!-- Rapport & conversion -->
    <div id="roi-resultat" class="mx-auto max-w-3xl" hidden>
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="rounded-2xl border border-amber-500/40 bg-[#080c14] p-5 shadow-[0_0_26px_rgba(251,191,36,0.10)]">
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-amber-300">
            <span aria-hidden="true">⚠</span> Alerte opérationnelle
          </p>
          <dl class="mt-3 space-y-2.5 text-sm">
            <div class="space-y-0.5">
              <dt class="text-xs text-slate-400">Temps dirigeant mobilisé</dt>
              <dd class="text-xl font-extrabold text-white">
                <span id="roi-heures">—</span> h / mois
                <span class="text-xs font-normal text-slate-400">(~ <span id="roi-heures-sem">—</span> h/semaine)</span>
              </dd>
            </div>
            <div class="space-y-0.5">
              <dt class="text-xs text-slate-400">Friction économique totale</dt>
              <dd class="text-xl font-extrabold text-amber-300">
                <span id="roi-perte">—</span> € <span class="text-xs font-normal text-slate-400">/ an</span>
              </dd>
              <dd class="text-[11px] text-slate-500">de chiffre d'affaires non capté.</dd>
            </div>
            <p class="border-t border-amber-500/20 pt-2 text-[11px] text-slate-400">
              Friction principale : <span id="roi-friction" class="text-amber-200">—</span>
            </p>
          </dl>
        </article>

        <article class="rounded-2xl border border-cyan-400/40 bg-[#080c14] p-5 shadow-[0_0_30px_rgba(0,229,255,0.14)]">
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-cyan-300">
            <span aria-hidden="true">▲</span> Solution &amp; projection Vortex Optim
          </p>
          <dl class="mt-3 space-y-2.5 text-sm">
            <div class="space-y-0.5">
              <dt class="text-xs text-slate-400">Gain net récupérable</dt>
              <dd class="text-xl font-extrabold text-white">
                + <span id="roi-gain">—</span> € <span class="text-xs font-normal text-slate-400">/ an</span>
              </dd>
            </div>
            <div class="space-y-0.5">
              <dt class="text-xs text-slate-400">Facteur d'impact</dt>
              <dd class="text-xl font-extrabold text-cyan-300">
                ×<span id="roi-ratio">—</span>
                <span class="text-xs font-normal text-slate-400">sur investissement</span>
              </dd>
            </div>
          </dl>
          <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Leviers activés</p>
          <ul class="mt-1.5 space-y-1.5 text-xs leading-relaxed text-slate-300">
            <li class="flex gap-2"><span class="text-cyan-400" aria-hidden="true">✓</span>Élimination de ~80% des no-shows via rappels WhatsApp/SMS automatiques.</li>
            <li class="flex gap-2"><span class="text-cyan-400" aria-hidden="true">✓</span>Relances devis programmées sans friction humaine.</li>
            <li class="flex gap-2"><span class="text-cyan-400" aria-hidden="true">✓</span>Prise de rendez-vous et qualification 24/7/365.</li>
          </ul>
        </article>
      </div>

      <div class="mt-6 flex flex-col items-center gap-3">
        <a
          id="roi-cta"
          href="/devis?pack=pro"
          class="roi-cta btn text-base"
        >
          Intégrer ce diagnostic à mon plan d'action personnalisé
        </a>
        <button id="roi-restart" type="button" class="btn btn-ghost text-xs">Recommencer l'audit</button>
        <p class="text-center text-xs text-slate-400">
          Estimation sur la base de vos 4 réponses — sans engagement. Le devis est pré-rempli avec le pack
          Pro Connecté (1 398 € la première année), ajustable en un clic.
        </p>
      </div>
    </div>

    <!-- Données du questionnaire sérialisées pour le <script> client -->
    <script
      is:inline
      type="application/json"
      id="roi-config"
      set:html={JSON.stringify({ questions: QUESTIONS, params: PARAMS })}
    />
  </div>
</section>
<style>
  /* Points de progression du wizard */
  .roi-dot {
    width: 0.5rem;
    height: 0.5rem;
    display: inline-block;
    border-radius: 9999px;
    border: 1px solid rgba(148, 163, 184, 0.6);
    background: transparent;
  }
  .roi-dot[data-active="true"] {
    background: #00e5ff;
    border-color: #00e5ff;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.55);
  }
  .roi-dot[data-done="true"] {
    background: rgba(0, 229, 255, 0.35);
    border-color: rgba(0, 229, 255, 0.5);
  }

  /* Option de réponse : état coché géré en CSS via :has() */
  .roi-opt:has(input:checked) {
    border-color: #00e5ff;
    background: rgba(4, 22, 34, 0.85);
    box-shadow:
      0 0 0 1px rgba(0, 229, 255, 0.45),
      0 0 22px -8px rgba(0, 229, 255, 0.5);
  }
  .roi-opt:has(input:focus-visible) {
    outline: 2px solid #00e5ff;
    outline-offset: 2px;
  }

  /* Transition douce entre étapes */
  .roi-step:not([hidden]) {
    animation: roi-step-in 0.26s ease;
  }
  @keyframes roi-step-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Spinner de l'analyse (1,2 s) */
  .roi-spinner {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-block;
    border-radius: 9999px;
    border: 2px solid rgba(0, 229, 255, 0.25);
    border-top-color: #00e5ff;
    animation: roi-spin 0.7s linear infinite;
  }
  @keyframes roi-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* CTA néon cyan */
  .roi-cta {
    color: #04121a;
    background: linear-gradient(120deg, #00e5ff, #22d3ee);
    box-shadow:
      0 0 24px -6px rgba(0, 229, 255, 0.7),
      0 0 46px -16px rgba(0, 229, 255, 0.45);
    border: 0;
  }
  .roi-cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 30px -4px rgba(0, 229, 255, 0.8),
      0 0 60px -18px rgba(0, 229, 255, 0.55);
  }
</style>
<script>
  /**
   * Audit Éclair — logique du tunnel 4 étapes (Vanilla JS, zéro dépendance).
   * Étape 2 — algorithme déterministe :
   *   heures_mois  = round(heures_declarees_semaine × 4,2)
   *   perte_noshow = volume × 0,12 × panier × 46
   *   perte_devis  = volume × taux_perte_devis × panier × 0,35 × 46
   *   cout_temps   = (heures_mois × 12) × 55
   *   perte_totale = round(perte_noshow + perte_devis + cout_temps × 0,4)
   *   gain_brut    = round(perte_noshow × 0,80 + perte_devis × 0,65 + cout_temps × 0,70)
   *   gain_net     = gain_brut − forfait
   *   roi          = min(max(round(gain_brut / forfait), 4), 9)
   */
  const raw = document.getElementById("roi-config")?.textContent;
  const wizard = document.getElementById("roi-wizard");
  if (raw && wizard) {
    const cfg = JSON.parse(raw);
    const reduced =
      typeof window.matchMedia === "function" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const eur0 = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
    const num1 = new Intl.NumberFormat("fr-FR", { maximumFractionDigits: 1 });

    const $ = (id: string): HTMLElement => document.getElementById(id)!;
    const stepEls = [1, 2, 3, 4].map((n) => $(`roi-step-${n}`));
    const dotEls = [0, 1, 2, 3].map((i) => $(`roi-dot-${i}`));
    const progressLabel = $("roi-progress-label");
    const analyseEl = $("roi-analyse");
    const resultatEl = $("roi-resultat");
    const wizardEl = wizard;

    const choices: (number | undefined)[] = [undefined, undefined, undefined, undefined];

    function showStep(n: number) {
      stepEls.forEach((el, i) => {
        el.hidden = i + 1 !== n;
      });
      dotEls.forEach((d, i) => {
        d.dataset.active = String(i + 1 === n);
        d.dataset.done = String(i + 1 < n);
      });
      progressLabel.textContent = `Question ${n} / 4`;
      const next = stepEls[n - 1];
      if (next) next.querySelector("legend")?.focus();
    }

    function calculer() {
      const q = cfg.questions;
      const opt = (qi: number, fallback: number) => q[qi].options[choices[qi] ?? fallback];
      const volume = opt(1, 1).volume ?? 0;
      const panier = opt(1, 1).panier ?? 0;
      const tauxPerte = opt(2, 1).taux ?? 0;
      const heuresSem = opt(3, 1).heures ?? 0;

      const heuresMois = Math.round(heuresSem * 4.2);
      const perteNoShow = volume * cfg.params.noShow * panier * cfg.params.semainesAn;
      const perteDevis = volume * tauxPerte * panier * 0.35 * cfg.params.semainesAn;
      const coutTemps = heuresMois * 12 * cfg.params.valeurHoraire;
      const perteTotale = Math.round(perteNoShow + perteDevis + coutTemps * 0.4);
      const gainBrut = Math.round(perteNoShow * 0.8 + perteDevis * 0.65 + coutTemps * 0.7);
      // Le gain affiché ET le facteur d'impact dérivent de la MÊME valeur bornée :
      // sinon la carte annonce « ×9 » à côté d'un gain correspondant à ×62.
      const gainBorne = Math.min(
        Math.max(gainBrut, cfg.params.roiMin * cfg.params.forfaitAn),
        cfg.params.roiMax * cfg.params.forfaitAn,
      );
      const gainNet = gainBorne - cfg.params.forfaitAn;
      const roi = Math.round(gainBorne / cfg.params.forfaitAn);
      const frictionLabel = opt(0, 0).label;

      return { heuresMois, heuresSemaine: heuresSem, perteTotale, gainNet, roi, frictionLabel };
    }

    function afficher(r: ReturnType<typeof calculer>) {
      $("roi-heures").textContent = num1.format(r.heuresMois);
      $("roi-heures-sem").textContent = num1.format(r.heuresSemaine);
      $("roi-perte").textContent = eur0.format(r.perteTotale);
      $("roi-friction").textContent = r.frictionLabel;
      $("roi-gain").textContent = eur0.format(Math.max(0, r.gainNet));
      $("roi-ratio").textContent = String(r.roi);
    }

    async function reveal() {
      wizardEl.hidden = true;
      analyseEl.hidden = false;
      if (!reduced) await new Promise((res) => setTimeout(res, 1200));
      analyseEl.hidden = true;
      const r = calculer();
      afficher(r);
      resultatEl.hidden = false;
      try {
        sessionStorage.setItem("vx_diag", JSON.stringify(r));
      } catch {
        /* stockage indisponible */
      }
      resultatEl.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "nearest" });
    }

    for (let qi = 0; qi < 4; qi++) {
      const radios = wizardEl.querySelectorAll<HTMLInputElement>(`input[name="roi-q${qi + 1}"]`);
      radios.forEach((radio) => {
        radio.addEventListener("change", () => {
          if (!radio.checked) return;
          choices[qi] = Number(radio.value);
          if (qi < 3) showStep(qi + 2);
          else void reveal();
        });
      });
    }

    $("roi-restart").addEventListener("click", () => {
      wizardEl.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => {
        r.checked = false;
      });
      choices.fill(undefined);
      resultatEl.hidden = true;
      analyseEl.hidden = true;
      wizardEl.hidden = false;
      showStep(1);
    });

    showStep(1);
  }
</script>
