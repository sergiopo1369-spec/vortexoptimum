---
import { SITE, NAV, CONTACT } from "../config/site";
const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_82%,transparent)] backdrop-blur-xl">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 font-semibold tracking-tight"
      aria-label={`${SITE.name} — accueil`}
    >
      <svg
        viewBox="0 0 32 32"
        class="h-7 w-7 shrink-0"
        aria-hidden="true"
        focusable="false"
      >
        {/*
          Vortex neuronal : trois bras en spirale autour d'un noyau, quatre nœuds
          reliés au centre. Le dégradé cyan → violet → magenta est propre à ce SVG
          (id unique) pour ne pas entrer en conflit avec celui de LogoGrid.
        */}
        <defs>
          <linearGradient id="vx-logo-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#00e5ff"></stop>
            <stop offset="55%" stop-color="#8b5cf6"></stop>
            <stop offset="100%" stop-color="#ff2fd0"></stop>
          </linearGradient>
        </defs>
        <g
          fill="none"
          stroke="url(#vx-logo-grad)"
          stroke-width="1.6"
          stroke-linejoin="round"
          stroke-linecap="round"
        >
          <path d="M16 4 Q27 7 28 16 Q28.6 23 22 27" />
          <path d="M22 27 Q13 30.5 7.5 24 Q3.6 18.6 9 13.5" />
          <path d="M9 13.5 Q15 9.5 19.5 14.5" />
          <path d="M16 10.5 V6.5 M22.8 19.4 L26.4 21 M13.8 23.6 L11.6 26.8 M10.6 17.4 L7 16.6" />
        </g>
        <circle cx="16" cy="16" r="2.6" fill="url(#vx-logo-grad)" />
        <g fill="url(#vx-logo-grad)">
          <circle cx="16" cy="6.5" r="1.5" />
          <circle cx="26.4" cy="21" r="1.5" />
          <circle cx="11.6" cy="26.8" r="1.5" />
          <circle cx="7" cy="16.6" r="1.5" />
        </g>
      </svg>
      <span>{SITE.name}</span>
    </a>

    <!-- Navigation bureau -->
    <nav aria-label="Navigation principale" class="hidden items-center gap-1 lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm transition-colors",
              isActive(item.href)
                ? "text-[var(--color-cyan-text)]"
                : "text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]",
            ]}
          >
            {item.lock && (
              <svg viewBox="0 0 448 512" class="h-3 w-3 shrink-0" aria-hidden="true" fill="currentColor">
                <path d="M400 224h-24v-72C376 68.2 307.8 0 224 0S72 68.2 72 168v56H48c-26.5 0-48 21.5-48 48v192c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V272c0-26.5-21.5-48-48-48zm-104 0H152v-56c0-39.7 32.3-72 72-72s72 32.3 72 72v56z" />
              </svg>
            )}
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Actions bureau -->
    <div class="hidden items-center gap-2 lg:flex">
      <a class="btn btn-ghost text-sm" href="/devis">Devis rapide</a>
      <a class="btn btn-whatsapp text-sm" href={`https://wa.me/${CONTACT.whatsapp.waMe}`} rel="noopener" target="_blank">💬 WhatsApp</a>

      {/*
        Motif décoratif d'extrémité : purement ornemental, donc aria-hidden et hors
        du flux de tabulation. Il ne double pas le lien d'accueil, qui reste le
        logo-marque à gauche.
      */}
      <svg viewBox="0 0 32 32" class="vx-orn" aria-hidden="true" focusable="false">
        <g fill="none" stroke="url(#vx-logo-grad)" stroke-width="1.4" stroke-linecap="round">
          <circle cx="16" cy="16" r="11" stroke-dasharray="3.2 5.4"></circle>
          <circle cx="16" cy="16" r="6.4" stroke-dasharray="2.4 4.2"></circle>
        </g>
        <circle cx="16" cy="16" r="2.2" fill="url(#vx-logo-grad)"></circle>
      </svg>
    </div>

    <!-- Menu mobile -->
    <details class="relative lg:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]"
        aria-label="Ouvrir le menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </summary>
      <nav
        aria-label="Navigation mobile"
        class="glass glass-strong absolute right-0 z-50 mt-2 flex w-60 flex-col gap-1 p-2"
      >
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm",
                isActive(item.href)
                  ? "text-[var(--color-cyan-text)]"
                  : "text-[var(--color-ink-muted)] hover:bg-[var(--color-surface-strong)] hover:text-[var(--color-ink)]",
              ]}
            >
              {item.lock && (
                <svg viewBox="0 0 448 512" class="h-3 w-3 shrink-0" aria-hidden="true" fill="currentColor">
                  <path d="M400 224h-24v-72C376 68.2 307.8 0 224 0S72 68.2 72 168v56H48c-26.5 0-48 21.5-48 48v192c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V272c0-26.5-21.5-48-48-48zm-104 0H152v-56c0-39.7 32.3-72 72-72s72 32.3 72 72v56z" />
                </svg>
              )}
              {item.label}
            </a>
          ))
        }
        <div class="my-1 h-px bg-[var(--color-border)]"></div>
        <a class="btn btn-ghost text-sm" href="/devis">Devis rapide</a>
        <a class="btn btn-whatsapp text-sm" href={`https://wa.me/${CONTACT.whatsapp.waMe}`} rel="noopener" target="_blank">💬 WhatsApp</a>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Motif d'extrémité : micro-glow et rotation lente, décoratif uniquement. */
  .vx-orn {
    width: 1.6rem;
    height: 1.6rem;
    margin-left: 0.35rem;
    flex: none;
    opacity: 0.85;
    filter: drop-shadow(0 0 5px rgba(0, 229, 255, 0.4)) drop-shadow(0 0 12px rgba(255, 47, 208, 0.2));
    animation: vx-orn-spin 26s linear infinite;
  }
  @keyframes vx-orn-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vx-orn {
      animation: none;
    }
  }
</style>
