---
import { CONTACT } from "../config/site";
import NeuralCanvas from "./NeuralCanvas.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
}
const { eyebrow = "Reims & Grand Est", title, subtitle } = Astro.props;

// Texture de fond générée par `npm run media:bg` (scripts/make-hero-bg.mjs) :
// dégradé vectoriel rendu en 2560/1280/640 px, net à toutes les tailles.
// Purement décorative (alt="") → jamais candidate au LCP (§6.2).
const BG_2560 = "/media/hero-bg-2560.webp";
const BG_1280 = "/media/hero-bg-1280.webp";
const BG_640 = "/media/hero-bg-640.webp";
---

<section class="relative isolate">
  <!-- Fond de base -->
  <div class="absolute inset-0 z-0" data-hero-bg aria-hidden="true">
    <div class="absolute inset-0" data-hero-bg-layer>
      <img
        src={BG_1280}
        srcset={`${BG_640} 640w, ${BG_1280} 1280w, ${BG_2560} 2560w`}
        sizes="100vw"
        width="2560"
        height="1440"
        alt=""
        class="h-full w-full object-cover"
        fetchpriority="low"
        decoding="async"
      />
    </div>
    <!-- Scrim optimisé -->
    <div
      class="absolute inset-0"
      style="background:
        linear-gradient(180deg, rgba(8,12,20,.30) 0%, rgba(8,12,20,.55) 45%, rgba(8,12,20,.92) 100%),
        radial-gradient(70rem 45rem at 25% 0%, rgba(34,211,238,.10), transparent 70%);"
    ></div>
  </div>

  {/*
    Hauteur bornée par min(…, 50rem) : « Demander la version pour ordinateur »
    sur téléphone rend la page dans une fenêtre virtuelle large mais très haute
    (980 × 2119 sur un iPhone 13). Les unités svh s'y rapportent, et 86svh
    donnait un hero de 1822 px — 721 px de vide avant le titre. Le plafond ne
    change rien sur un vrai écran d'ordinateur (774 px à 1280 × 900).
  */}
  <div
    class="container-page relative z-10 grid min-h-[min(76svh,50rem)] items-center gap-8 py-12 sm:min-h-[min(86svh,50rem)] sm:gap-10 sm:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12"
  >
    {/* relative z-10 : le texte reste au-dessus du réseau passé en fond sous lg. */}
    <div class="relative z-10 flex min-w-0 flex-col">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl md:text-6xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-base text-[var(--color-ink-muted)] sm:mt-6 sm:text-lg">{subtitle}</p>

      <!-- Mobile : deux boutons pleine largeur, donc de largeur égale. En ligne dès sm. -->
      <div class="mt-7 grid grid-cols-1 gap-3 sm:mt-9 sm:flex sm:flex-wrap">
        <a class="btn btn-primary" href="/devis">Estimer mon projet en 1 min</a>
        <a class="btn btn-whatsapp" href={`https://wa.me/${CONTACT.whatsapp.waMe}`} rel="noopener" target="_blank">
          💬 Discuter sur WhatsApp
        </a>
      </div>

      <p class="mt-4 text-sm text-[var(--color-ink-muted)] sm:mt-5">
        ⏱ Combien d'heures perdez-vous chaque mois à gérer vos rendez-vous ?{" "}
        <a href="/devis" class="font-semibold text-[var(--color-cyan-text)] link-underline">
          Calculez-le en 30 secondes →
        </a>
      </p>

      <dl class="mt-8 grid max-w-2xl grid-cols-1 gap-x-6 gap-y-3 text-sm min-[420px]:grid-cols-3 sm:mt-12 sm:gap-y-4">
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Mise en ligne technique</dt>
          <dd class="text-[var(--color-ink)]">24h à 48h<span class="text-[var(--color-ink-faint)]">*</span></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Performance mobile visée</dt>
          <dd class="text-[var(--color-ink)]">Lighthouse ≥ 90</dd>
        </div>
        <div class="min-w-0">
          <dt class="text-[var(--color-ink-faint)]">Contact WhatsApp</dt>
          <dd class="text-[var(--color-ink)]">Jours ouvrés, 9h–19h</dd>
        </div>
      </dl>
      <p class="mt-4 max-w-2xl text-xs text-[var(--color-ink-faint)]">
        * Délai de mise en ligne technique à compter de la réception complète et validée
        de vos contenus (textes, logo, domaine, photos). En l'absence d'un élément, le
        délai démarre à réception du dernier élément manquant.
      </p>
    </div>

    {/*
      Sous lg, le réseau passe en arrière-plan centré et atténué : il ne
      réserve plus de colonne, donc plus de zone vide sous le texte. À partir
      de lg il redevient un bloc du tiers droit de la grille.
    */}
    <div class="hero-net">
      <NeuralCanvas />
    </div>
  </div>
</section>

<style>
  /* Hero styles fixes - sin overflow */
  [data-hero-bg-layer] {
    transform: none;
    will-change: auto;
  }

  /*
    Sous lg : le réseau neuronal est sorti du flux et centré derrière le
    texte, atténué pour rester lisible sous les titres. `pointer-events: none`
    garantit que le défilement tactile n'est jamais intercepté.
    C'est ce retrait du flux — et non une hauteur forcée — qui supprime la
    zone vide : la colonne du réseau ne réserve plus d'espace sous le contenu.
  */
  .hero-net {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-net :global(.nc) {
    max-width: min(88vw, 26rem);
  }

  @media (min-width: 1024px) {
    .hero-net {
      position: static;
      inset: auto;
      opacity: 1;
      display: block;
    }
    .hero-net :global(.nc) {
      max-width: 30rem;
    }
  }
  
  /* Styles bouton WhatsApp */
  .btn-whatsapp {
    background: linear-gradient(135deg, #25D366 0%, #1da851 100%);
    border: 2px solid #25D366;
    color: white !important;
    box-shadow: 0 0 15px rgba(37, 211, 102, 0.3);
    transition: all 0.3s ease;
  }
  
  .btn-whatsapp:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(37, 211, 102, 0.4);
    border-color: #1da851;
  }
</style>

