---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuestionnaireRendezVous from "../components/QuestionnaireRendezVous.astro";
import { CONTACT } from "../config/site";
---

<BaseLayout
  title="Prendre rendez-vous"
  description="Décrivez votre activité en quatre étapes et choisissez un créneau : visioconférence ou visite sur place avec démonstration. Réponse par WhatsApp, sans inscription."
  path="/rendez-vous"
>
  <section class="container-page py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Prise de rendez-vous</p>
      <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">Parlons de votre projet</h1>
      <p class="mt-4 text-[var(--color-ink-muted)]">
        Quatre questions, moins de deux minutes. Nous préparons le rendez-vous à partir de vos
        réponses pour aller droit au but — en visioconférence, ou chez vous avec une démonstration
        en direct. Vos réponses partent sur WhatsApp ou par e-mail&nbsp;; rien n'est enregistré sur
        ce site (voir la
        <a class="link-underline" href="/politique-de-confidentialite">politique de confidentialité</a>).
      </p>
    </div>

    <div class="mx-auto mt-8 max-w-3xl">
      <QuestionnaireRendezVous />
    </div>

    <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-[var(--color-ink-muted)]">
      Vous préférez écrire directement&nbsp;?
      <a
        class="link-underline font-semibold text-[var(--color-cyan-text)]"
        href={`https://wa.me/${CONTACT.whatsapp.waMe}`}
        rel="noopener"
        target="_blank">Ouvrir WhatsApp</a
      >
      — {CONTACT.hours}.
    </p>
  </section>
</BaseLayout>
