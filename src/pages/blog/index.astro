---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PostCover from "../../components/PostCover.astro";

const posts = (await getCollection("blog", ({ data }) => import.meta.env.PROD ? !data.draft : true)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const df = new Intl.DateTimeFormat("fr-FR", { dateStyle: "long" });
---

<BaseLayout
  title="Blog"
  description="Stratégies locales, Google Ads, IA et performance web pour les commerces de Reims et du Grand Est."
  path="/blog"
>
  <section class="container-page py-16">
    <SectionHeading
      eyebrow="Ressources"
      title="Stratégies locales, Google Ads & IA"
      lead="Des analyses concrètes pour les artisans, commerçants et PME qui veulent des résultats mesurables — pas du jargon."
    />

    <ul class="mt-12 grid gap-8 md:grid-cols-2">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="glass block h-full overflow-hidden p-4 transition-colors hover:glass-strong">
              <PostCover cover={post.data.cover} concept={post.data.imageConcept} compact />
              <div class="p-2">
                <p class="mt-4 text-xs text-[var(--color-ink-faint)]">
                  <time datetime={post.data.pubDate.toISOString()}>{df.format(post.data.pubDate)}</time>
                </p>
                <h2 class="mt-2 text-xl font-semibold">{post.data.title}</h2>
                <p class="mt-2 text-sm text-[var(--color-ink-muted)]">{post.data.description}</p>
                <span class="mt-3 inline-block text-sm text-[var(--color-cyan-text)]">Lire l'article →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
