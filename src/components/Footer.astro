---
import { SITE, CONTACT, NAV, LEGAL_NAV } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-border)] bg-[var(--color-bg-soft)]">
  <div class="container-page grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 font-semibold">
        <span class="inline-block h-5 w-5 rounded bg-gradient-to-br from-[var(--color-cyan)] via-[var(--color-amethyst)] to-[var(--color-emerald)]"></span>
        {SITE.name}
      </div>
      <p class="mt-3 max-w-sm text-sm text-[var(--color-ink-muted)]">
        {SITE.tagline}. Partenaire technologique et développeur web de proximité à Reims —
        écosystèmes digitaux haute performance, acquisition locale et agents IA.
      </p>
      <p class="mt-4 text-sm text-[var(--color-ink-muted)]">
        Zone d'intervention : {SITE.zone}. Déplacement offert jusqu'à {SITE.serviceRadiusKm} km autour de Reims.
      </p>
    </div>

    <nav aria-label="Pages" class="text-sm">
      <h2 class="mb-3 font-semibold">Navigation</h2>
      <ul class="space-y-2 text-[var(--color-ink-muted)]">
        {NAV.map((i) => (
          <li><a class="hover:text-[var(--color-ink)]" href={i.href}>{i.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="mb-3 font-semibold">Contact direct</h2>
      <ul class="space-y-2 text-[var(--color-ink-muted)]">
        <li>
          <a class="hover:text-[var(--color-ink)]" href={`https://wa.me/${CONTACT.whatsapp.waMe}`} rel="noopener">
            {CONTACT.whatsapp.label} — {CONTACT.whatsapp.display}
          </a>
        </li>
        <li>
          <a class="hover:text-[var(--color-ink)]" href={`sms:${CONTACT.sms.e164}`}>
            {CONTACT.sms.label} — {CONTACT.sms.display}
          </a>
        </li>
        <li>
          <a class="hover:text-[var(--color-ink)]" href={CONTACT.calcom.url} rel="noopener">
            {CONTACT.calcom.label}
          </a>
        </li>
        <li>
          <a class="hover:text-[var(--color-ink)]" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
      </ul>
      <p class="mt-3 text-xs text-[var(--color-ink-faint)]">{CONTACT.hours}</p>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div class="container-page flex flex-col gap-3 py-6 text-xs text-[var(--color-ink-faint)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. Tous droits réservés.</p>
      <nav aria-label="Informations légales" class="flex flex-wrap gap-x-4 gap-y-1">
        {LEGAL_NAV.map((i) => (
          <a class="hover:text-[var(--color-ink-muted)]" href={i.href}>{i.label}</a>
        ))}
        <button type="button" data-open-cookie-settings class="hover:text-[var(--color-ink-muted)]">
          Gérer les cookies
        </button>
      </nav>
    </div>
  </div>
</footer>
