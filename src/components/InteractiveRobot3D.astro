---
/*
  Agent IA en scène 3D — élément décoratif du Héro.

  - SSR : seul le fallback SVG animé (CSS pur, ~1 Ko) est rendu. Aucun code
    navigateur dans le frontmatter.
  - WebGL dispo et sans prefers-reduced-motion — mobile compris : un <canvas>
    Three.js prend le relais, chargé en chunk séparé via import() dynamique
    déclenché par IntersectionObserver, jamais dans le bundle principal.
    Sous 640 px la scène abaisse son pixel-ratio (voir ai-core-scene.ts).
  - Fallback (pas de WebGL / reduced-motion) : le SVG reste, figé si
    reduced-motion. Three.js n'est alors jamais téléchargé.
  - `pointer-events: none` + `aria-hidden` : purement décoratif, n'intercepte
    ni clic ni scroll.
*/
interface Props {
  class?: string;
}
const { class: klass = "" } = Astro.props;
---

<div class:list={["ir3d", klass]} data-ir3d-root aria-hidden="true">
  <svg
    class="ir3d__fallback"
    viewBox="0 0 200 200"
    width="200"
    height="200"
    role="presentation"
    focusable="false"
  >
    <defs>
      <radialGradient id="ir3dGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#00e5ff" stop-opacity="0.5"></stop>
        <stop offset="55%" stop-color="#00e5ff" stop-opacity="0.06"></stop>
        <stop offset="100%" stop-color="#00e5ff" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle cx="100" cy="100" r="94" fill="url(#ir3dGlow)"></circle>
    <g class="ir3d__ring" stroke="#00e5ff" fill="none" stroke-width="1">
      <circle cx="100" cy="100" r="72" stroke-opacity="0.32" stroke-dasharray="4 9"></circle>
      <circle cx="100" cy="100" r="54" stroke-opacity="0.5" stroke-dasharray="2 6"></circle>
    </g>
    <g class="ir3d__ring-rev" fill="#a855f7">
      <circle cx="100" cy="28" r="3.4"></circle>
      <circle cx="172" cy="100" r="2.6"></circle>
      <circle cx="100" cy="172" r="3"></circle>
      <circle cx="28" cy="100" r="2.4"></circle>
    </g>
    <circle class="ir3d__pulse" cx="100" cy="100" r="8" fill="#00e5ff"></circle>
  </svg>

  <canvas class="ir3d__canvas" hidden></canvas>
</div>

<style>
  .ir3d {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    touch-action: pan-y;
    -webkit-mask-image: radial-gradient(ellipse 72% 72% at 50% 50%, #000 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 72% 72% at 50% 50%, #000 55%, transparent 100%);
  }

  .ir3d__fallback,
  .ir3d__canvas {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 42px rgba(0, 229, 255, 0.28));
    transition: opacity 0.6s ease;
  }

  .ir3d__fallback {
    max-width: 20rem;
  }

  .ir3d__canvas {
    opacity: 0;
  }
  .ir3d__canvas:not([hidden]) {
    opacity: 1;
  }
  .ir3d:has(.ir3d__canvas:not([hidden])) .ir3d__fallback {
    opacity: 0;
  }

  .ir3d__ring {
    transform-origin: 100px 100px;
    animation: ir3d-rot 26s linear infinite;
  }
  .ir3d__ring-rev {
    transform-origin: 100px 100px;
    animation: ir3d-rot 20s linear infinite reverse;
  }
  .ir3d__pulse {
    transform-origin: 100px 100px;
    animation: ir3d-pulse 3.4s ease-in-out infinite;
  }

  @keyframes ir3d-rot {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes ir3d-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.5);
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ir3d__ring,
    .ir3d__ring-rev,
    .ir3d__pulse {
      animation: none;
    }
  }
</style>

<script>
  import type { CoreHandle } from "../scripts/ai-core-scene";

  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      return !!(
        window.WebGLRenderingContext &&
        (c.getContext("webgl") || c.getContext("experimental-webgl"))
      );
    } catch {
      return false;
    }
  }

  const roots = document.querySelectorAll<HTMLElement>("[data-ir3d-root]");

  roots.forEach((root) => {
    if (root.dataset.ir3dInit) return;
    root.dataset.ir3dInit = "1";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    // La scène tourne aussi sur mobile : le chunk Three.js n'est chargé qu'à
    // l'entrée en vue, et la scène abaisse son pixel-ratio sous 640 px.
    // Sans WebGL, ou en mouvement réduit, le fallback SVG reste en place et
    // Three.js n'est jamais téléchargé.
    if (reduced.matches || !hasWebGL()) return;

    const canvas = root.querySelector<HTMLCanvasElement>(".ir3d__canvas");
    if (!canvas) return;

    let handle: CoreHandle | null = null;
    let started = false;
    let inView = false;
    let pointerQueued = false;

    const sync = () => handle?.setRunning(inView && !document.hidden);

    const io = new IntersectionObserver(
      async (entries) => {
        inView = entries[0].isIntersecting;
        if (inView && !started) {
          started = true;
          try {
            const mod = await import("../scripts/ai-core-scene");
            handle = mod.initAiCore(canvas, reduced.matches);
            canvas.hidden = false;
            sync();
          } catch {
            started = false; // échec → le SVG reste
          }
          return;
        }
        sync();
      },
      { rootMargin: "200px" },
    );
    io.observe(root);

    document.addEventListener("visibilitychange", sync);

    window.addEventListener(
      "pointermove",
      (e) => {
        if (!handle || pointerQueued) return;
        pointerQueued = true;
        const { clientX, clientY } = e;
        requestAnimationFrame(() => {
          pointerQueued = false;
          handle?.setPointer(
            (clientX / window.innerWidth) * 2 - 1,
            (clientY / window.innerHeight) * 2 - 1,
          );
        });
      },
      { passive: true },
    );

    const ro = new ResizeObserver(() => handle?.resize());
    ro.observe(root);
  });
</script>
